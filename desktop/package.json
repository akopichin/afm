{
  "name": "afm-desktop",
  "productName": "AFM Desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "npm run prepare:assets && electron .",
    "prepare:assets": "node scripts/assets.js",
    "test": "node --test --test-concurrency=3 test/*.test.js",
    "check": "node scripts/check.js",
    "sidecar": "node scripts/sidecar.js",
    "build": "npm run prepare:assets && node scripts/build.js",
    "demo": "npm run prepare:assets && electron . --demo",
    "check:package": "node scripts/check-package.js",
    "perf": "node scripts/perf.js && node scripts/perf-runtime.js",
    "smoke:mac": "node scripts/smoke-mac.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.9.1",
    "@langchain/anthropic": "1.6.6",
    "@langchain/core": "1.5.0",
    "@langchain/langgraph": "1.7.5",
    "@langchain/langgraph-checkpoint": "1.2.3",
    "@langchain/langgraph-sdk": "1.17.0",
    "@langchain/openai": "1.8.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "chrome-devtools-mcp": "1.12.0",
    "deepagents": "1.17.0",
    "langchain": "1.6.7",
    "ws": "8.23.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@agentclientprotocol/codex-acp": "2.9.0",
    "@electron/asar": "4.3.2",
    "@electron/packager": "20.3.0",
    "electron": "45.4.1",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "monaco-editor": "0.57.0"
  }
}
