#!/usr/bin/env bash
# Fake `claude`: records a marker, writes the stage summary and emits stream-json success.
set -euo pipefail

cat >/dev/null 2>&1 || true # the prompt arrives on stdin or -p; its content is irrelevant

argv_file="${FAKE_AGENT_ARGV_FILE:-}"
if [[ -n "$argv_file" ]]; then
    printf 'claude %q\n' "$*" >>"$argv_file"
fi

marker="${FAKE_AGENT_MARKER_FILE:-}"
if [[ -n "$marker" ]]; then
    printf 'claude stage=%s\n' "${AFM_STAGE_NAME:-}" >>"$marker"
fi

# Hold the stage until the test creates the release file, so it can interrupt a running agent.
release="${FAKE_AGENT_RELEASE_FILE:-}"
if [[ -n "$release" ]]; then
    for _ in $(seq 1 "${FAKE_AGENT_RELEASE_TIMEOUT:-60}"); do
        [[ -e "$release" ]] && break
        sleep 1
    done
fi

if [[ -n "${AFM_STAGE_DIR:-}" ]]; then
    printf '# Summary\n\nDone by fake claude.\n' >"$AFM_STAGE_DIR/execution_summary.md"
fi

printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"text","text":"fake claude done"}]}}'
printf '%s\n' '{"type":"result","subtype":"success"}'
