# Pinned uv uses a named FROM stage because BuildKit does not expand variables in COPY --from.
ARG UV_VERSION=0.12.6
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

# Stage 1: build React dashboard (Vite → index.html + assets/ + статика из public/)
FROM node:22-bookworm-slim AS web
WORKDIR /dash
# Сначала только манифесты зависимостей — слой npm ci кэшируется отдельно от
# исходников и не инвалидируется при правках в src/.
COPY pkg/web/dashboard/package.json pkg/web/dashboard/package-lock.json ./
RUN npm ci
COPY pkg/web/dashboard/ .
RUN npm run build

# Stage 2: build afm binary (вкомпилирует собранный дашборд через go:embed)
FROM golang:1.26-bookworm AS builder
WORKDIR /src
COPY . .
# Удаляем старые assets/skins перед COPY свежего дашборда, чтобы go:embed не включил устаревшие бандлы.
RUN rm -rf ./pkg/web/dashboard/assets ./pkg/web/dashboard/skins
COPY --from=web /dash/assets ./pkg/web/dashboard/assets
COPY --from=web /dash/skins ./pkg/web/dashboard/skins
COPY --from=web /dash/index.html /dash/favicon.svg /dash/quarium-logo.png ./pkg/web/dashboard/
ARG AFM_VERSION=dev
RUN CGO_ENABLED=0 go build -ldflags="-X main.version=$AFM_VERSION" -o /afm ./cmd/afm

# Stage 3: runtime environment
FROM ubuntu:24.04

# Node 22 + Python 3.12 + dev tools + gosu (для дропа привилегий до host-uid)
RUN apt-get update && apt-get install -y \
      curl \
      git \
      ca-certificates \
      gnupg \
      gosu \
      jq \
      python3 \
      python3-pip \
      python3-venv \
      build-essential && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# uv: готовые статические бинарники из pinned-stage выше (быстрее и надёжнее
# curl-инсталлера, не завязано на apt-фид Ubuntu).
COPY --from=uv /uv /uvx /usr/local/bin/

# Go 1.26 (для verify: go test и подобных команд в flow)
COPY --from=builder /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:$PATH"

# Claude CLI version is pinned; bump only after testing with the afm release.
ARG CLAUDE_CODE_VERSION=2.1.304
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}

# codex CLI. Версию фиксируем и меняем только после ручной проверки с afm
# (0.156.1 падал с SIGSEGV на Linux arm64 даже на --version; 0.163.0 проверен).
ARG CODEX_VERSION=0.163.0
RUN npm install -g @openai/codex@${CODEX_VERSION}

# Chrome DevTools MCP for the managed browser capability. Must match
# browser.PinnedChromeDevtoolsMCPVersion.
ARG CHROME_DEVTOOLS_MCP_VERSION=1.12.0
RUN npm install -g chrome-devtools-mcp@${CHROME_DEVTOOLS_MCP_VERSION}

# afm binary
COPY --from=builder /afm /usr/local/bin/afm

# Дом для non-root пользователя (entrypoint chown'ит его под host-uid и ставит HOME).
RUN mkdir -p /home/afm

# Entrypoint-shim: дропает root → host-uid через gosu, затем запускает afm.
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# openai-as-claude: транслятор для OpenAI-совместимых провайдеров (cursor, deepseek, и т.д.)
COPY scripts/openai-as-claude.sh /usr/local/bin/openai-as-claude
RUN chmod +x /usr/local/bin/openai-as-claude

# openai-agent-as-claude: реальный tool-loop (bash tool + function calling) поверх
# OpenAI-совместимых провайдеров с tool-calling (IdeaLab и т.п.)
COPY scripts/openai-agent-as-claude.sh /usr/local/bin/openai-agent-as-claude
RUN chmod +x /usr/local/bin/openai-agent-as-claude

# cursor-as-claude: адаптер Cursor Cloud Agents API (асинхронный run-based → claude stream-json)
COPY scripts/cursor-as-claude.sh /usr/local/bin/cursor-as-claude
RUN chmod +x /usr/local/bin/cursor-as-claude

# codex-as-claude: адаптер codex JSONL (`codex exec --json`) → claude stream-json
COPY scripts/codex-as-claude.sh /usr/local/bin/codex-as-claude
RUN chmod +x /usr/local/bin/codex-as-claude

# afm-telegram-notify: lifecycle-hook нотификатор в Telegram. Запекаем в образ, чтобы флоу с hook'ом
# работал без монтирования скрипта.
COPY scripts/telegram-notify.sh /usr/local/bin/afm-telegram-notify
RUN chmod +x /usr/local/bin/afm-telegram-notify

WORKDIR /project
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
